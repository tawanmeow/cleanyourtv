<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape><solid android:color="@color/tokyo_muted" /><corners android:radius="1dp" /></shape>
    </item>
    <item android:id="@android:id/progress">
        <scale android:scaleWidth="100%" android:gravity="left">
            <shape><solid android:color="@color/terminal_green" /><corners android:radius="1dp" /></shape>
        </scale>
    </item>
</layer-list>
