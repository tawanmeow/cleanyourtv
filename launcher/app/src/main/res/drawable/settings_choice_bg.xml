<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#3363B3FF" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="@color/terminal_green" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#229B7BFF" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/tokyo_purple" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tokyo_panel" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
