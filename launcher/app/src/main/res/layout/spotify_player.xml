<?xml version="1.0" encoding="utf-8"?>
<com.gathin.tvhome.SpotifyWidgetLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/spotifyPlayer"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="right"
    android:layout_marginTop="15dp"
    android:layoutDirection="ltr"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/spotify_widget_panel"
    android:visibility="gone">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView style="@style/SpotifyText" android:layout_width="0dp" android:layout_weight="1"
            android:text="@string/spotify_label" android:textColor="@color/tokyo_text"
            android:fontFamily="@font/jetbrains_mono_semibold" />
        <TextView android:id="@+id/spotifyState" style="@style/SpotifyText"
            android:layout_width="wrap_content" android:textSize="8sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
        android:layout_marginTop="5dp" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/spotifyArtwork" android:layout_width="48dp"
            android:layout_height="48dp" android:layout_marginEnd="6dp"
            android:scaleType="centerCrop" android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:minWidth="0dp" android:orientation="vertical">
            <com.gathin.tvhome.ScrollingSongTitle android:id="@+id/spotifyTitle" style="@style/SpotifyText"
                android:fontFamily="@font/jetbrains_mono_semibold" android:textColor="@color/tokyo_text" />
            <TextView android:id="@+id/spotifyArtist" style="@style/SpotifyText" android:layout_marginTop="3dp" />
            <TextView android:id="@+id/spotifyAlbum" style="@style/SpotifyText" android:layout_marginTop="3dp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/spotifyProgressGroup" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical"
        android:layout_marginTop="5dp" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/spotifyElapsed" style="@style/SpotifyText"
                android:layout_width="0dp" android:layout_weight="1" android:textSize="8sp" />
            <TextView android:id="@+id/spotifyDuration" style="@style/SpotifyText"
                android:layout_width="wrap_content" android:textSize="8sp" />
        </LinearLayout>
        <ProgressBar android:id="@+id/spotifyProgress" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="2dp" android:layout_marginTop="3dp"
            android:progressDrawable="@drawable/spotify_progress_track" android:indeterminate="false"
            android:max="1000" android:padding="0dp" android:importantForAccessibility="no" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="26dp"
        android:layout_marginTop="5dp" android:gravity="center" android:orientation="horizontal"
        android:clipChildren="false" android:clipToPadding="false">
        <ImageButton android:id="@+id/spotifyPrevious" style="@style/SpotifyControl"
            android:src="@android:drawable/ic_media_previous" android:contentDescription="@string/spotify_previous" />
        <ImageButton android:id="@+id/spotifyToggle" style="@style/SpotifyControl"
            android:layout_width="22dp" android:layout_height="22dp"
            android:layout_marginStart="12dp" android:layout_marginEnd="12dp"
            android:src="@android:drawable/ic_media_play" android:contentDescription="@string/spotify_play" />
        <ImageButton android:id="@+id/spotifyNext" style="@style/SpotifyControl"
            android:src="@android:drawable/ic_media_next" android:contentDescription="@string/spotify_next" />
    </LinearLayout>
</com.gathin.tvhome.SpotifyWidgetLayout>
